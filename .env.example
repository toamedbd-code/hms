APP_NAME=HMS
APP_VERSION=2.1.1
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
INVOICE_FOOTER_FALLBACK_LINE="Powered By: www.toamedit.com Support: 01919-592638"
WEB_SETTING_CACHE_TTL_SECONDS=300
SIDE_MENU_CACHE_TTL_SECONDS=180
ACTIVITY_LOG_ALERT_CACHE_TTL_SECONDS=60
MEDICINE_EXPIRY_ALERT_CACHE_TTL_SECONDS=120

# Database
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hms
DB_USERNAME=root
DB_PASSWORD=

# Attendance integration defaults
ATTENDANCE_SCHEDULED_START=09:00
ATTENDANCE_SCHEDULED_END=17:00
ATTENDANCE_LATE_THRESHOLD_MINUTES=60
ATTENDANCE_OVERTIME_THRESHOLD_MINUTES=60
ATTENDANCE_LATE_DEDUCTION_PER_HOUR=200
ATTENDANCE_OVERTIME_RATE_PER_HOUR=300

# Toggle subscription enforcement: when true, inactive subscription blocks admin login and redirects
# admins to the bKash settings/payment page. Set to false to disable enforcement during development.
SUBSCRIPTION_ENFORCE=true

# Subscription plan amounts (in your currency)
SUBSCRIPTION_MONTHLY_AMOUNT=2000
SUBSCRIPTION_YEARLY_AMOUNT=20000
SUBSCRIPTION_DEFAULT_PERIOD=monthly

# bKash Tokenized Checkout (sandbox / production)
# Working sandbox API root (Grant Token): .../v1.2.0-beta
BKASH_SANDBOX_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_PRODUCTION_BASE_URL=https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_TOKEN_ENDPOINT=/tokenized/checkout/token/grant
BKASH_CREATE_PAYMENT_ENDPOINT=/tokenized/checkout/create
BKASH_EXECUTE_PAYMENT_ENDPOINT=/tokenized/checkout/execute
BKASH_QUERY_PAYMENT_ENDPOINT=/tokenized/checkout/payment/status

# Credentials from bKash PGW onboarding email
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
# bKash requires 30s timeout for all APIs
BKASH_HTTP_TIMEOUT=30
BKASH_HTTP_VERIFY_SSL=false

# Payment feature toggle: set to false to disable payment/public flows quickly
# Set to true (or 1) to allow payments; set to false to disable.
PAYMENT_ENABLED=true
# Optional descriptive mode flag
PAYMENT_MODE=on

# Login page heading texts (editable via admin)
LOGIN_BANNER="Hospital Management Suite"
LOGIN_TITLE="Welcome Back."
LOGIN_SUBTITLE="Continue with your secure account and manage all operations with confidence."
