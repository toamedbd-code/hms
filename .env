# Attendance Configuration
ATTENDANCE_SCHEDULED_START=09:00
ATTENDANCE_SCHEDULED_END=17:00
ATTENDANCE_LATE_THRESHOLD_MINUTES=60
ATTENDANCE_OVERTIME_THRESHOLD_MINUTES=60
ATTENDANCE_LATE_DEDUCTION_PER_HOUR=0
ATTENDANCE_OVERTIME_RATE_PER_HOUR=0
FACE_THRESHOLD=0.6
ATTENDANCE_GOOGLE_HOLIDAYS_ENABLED=true
ATTENDANCE_GOOGLE_HOLIDAY_COUNTRY=bd
ATTENDANCE_GOOGLE_HOLIDAY_ICS_URL="https://calendar.google.com/calendar/ical/en.bd%23holiday%40group.v.calendar.google.com/public/basic.ics"
ATTENDANCE_WEEKLY_HOLIDAYS=5,6

# Disable subscription enforcement (set false to allow login when subscription is inactive)
SUBSCRIPTION_ENFORCE=false

# Subscription plan amounts (in your currency)
SUBSCRIPTION_MONTHLY_AMOUNT=2000
SUBSCRIPTION_YEARLY_AMOUNT=20000
SUBSCRIPTION_DEFAULT_PERIOD=monthly

# bKash merchant settings (local/dev defaults)
BKASH_MERCHANT_ACCOUNT=
BKASH_API_URL=https://api.bkash.example.com
BKASH_API_KEY=

# Payment feature toggle (added by dev):
# Set to false to disable payment flows; true to enable.
PAYMENT_ENABLED=false
PAYMENT_MODE=off

# Login page heading texts (editable via admin)
LOGIN_BANNER="Hospital Management Suite"
LOGIN_TITLE="Welcome Back."
LOGIN_SUBTITLE="Continue with your secure account and manage all operations with confidence."

# Sidebar debug override (use cautiously; do not enable in production)
# Set to true to force full unfiltered sidebar menus for developers or specific emails.
FORCE_FULL_SIDEBAR=false
# When true and FORCE_FULL_SIDEBAR=true, show full menus for all users
# When true and FORCE_FULL_SIDEBAR=true, show full menus for all users
FORCE_FULL_SIDEBAR_FORCE_ALL=false
# Allow users with `developer` role to see full menus when override enabled
FORCE_FULL_SIDEBAR_ALLOW_DEVS=false
# Comma-separated emails that should see full menus when override enabled
FORCE_FULL_SIDEBAR_EMAILS=toamedbd@gmail.com
# Comma-separated emails that should use strict sidebar filtering (show only assigned permissions)
SIDEBAR_STRICT_EMAILS=eti@gmail.com
