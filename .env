# bKash signing / signature settings for sandbox tokenized API
# These values ensure AWS4-like signing matches bKash sandbox expectations
BKASH_AWS_REGION=ap-southeast-1
BKASH_SIGNATURE_REGION=ap-southeast-1
# Try standard AWS4/execute-api signing which the sandbox often accepts
BKASH_SIGNATURE_SERVICE=execute-api
BKASH_SIGNATURE_ALGORITHM=AWS4-HMAC-SHA256
BKASH_CREDENTIAL_SCOPE_SUFFIX=aws4_request
BKASH_SIGNATURE_KEY_PREFIX=AWS4

