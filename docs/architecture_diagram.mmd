flowchart TD
  subgraph clients [Clients]
    browser[Browser / Mobile App]
  end

  browser --> cdn[CDN]
  cdn --> lb[Load Balancer / Nginx]
  lb --> web[Web / API (Laravel PHP-FPM)]

  subgraph app_cluster [Application Cluster]
    web --> cache[(Redis)]
    web --> db[(MySQL Primary)]
    web --> storage[(S3 / Object Storage)]
    web --> queue[Queue (Redis)]
    queue --> workers[Workers (Laravel Jobs)]
    workers --> db
    workers --> storage
  end

  db --> replica[(Read Replica)]

  web --> ext[External Services]
  ext --> payment[Payment Gateways (bKash, Bank APIs)]
  ext --> sms[SMS / Email Gateways]
  ext --> attendance[Attendance Devices / Systems]

  monitoring[Monitoring & Observability]
  logging[Logging / Sentry / ELK]
  ci[CI/CD (GitHub Actions)]
  registry[Container Registry]

  web --- logging
  web --- monitoring
  ci --> registry --> deploy[Deploy (Docker / K8s)]
  deploy --> lb

  classDef infra fill:#f9f,stroke:#333,stroke-width:1px;
  class infra lb,web,workers,db,replica,cache,storage,queue infra
